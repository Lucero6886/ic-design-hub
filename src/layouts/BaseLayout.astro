---
/**
 * Layout gốc: <head> đầy đủ SEO/OG/canonical + header + footer.
 * Danh tính (tác giả/bản quyền) lấy từ cấu hình trung tâm — không hard-code.
 */
import { SITE, AUTHOR, COPYRIGHT } from "~/config/site";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import "~/styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** đường dẫn hiện tại tương-đối-với-gốc-site, vd "articles/fsm/" — dùng cho canonical */
  path?: string;
  /** loại nội dung cho OG */
  ogType?: "website" | "article";
  /** ngày ISO cho article */
  published?: string;
  modified?: string;
  /** không cho index (trang search…) */
  noindex?: boolean;
  lang?: string;
}

const {
  title,
  description = SITE.description,
  path = "",
  ogType = "website",
  published,
  modified,
  noindex = false,
  lang = SITE.lang,
} = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
const canonical = Astro.site
  ? new URL(import.meta.env.BASE_URL.replace(/\/?$/, "/") + path.replace(/^\/+/, ""), Astro.site).href
  : undefined;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR.name} />
    <meta name="copyright" content={COPYRIGHT.notice(year)} />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={import.meta.env.BASE_URL.replace(/\/?$/, "/") + "favicon.svg"} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={import.meta.env.BASE_URL.replace(/\/?$/, "/") + "rss.xml"}
    />
    <meta name="sitemap" content={import.meta.env.BASE_URL.replace(/\/?$/, "/") + "sitemap-index.xml"} />

    <!-- Open Graph / social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={lang === "vi" ? "vi_VN" : "en_US"} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary" />

    <!-- theme trước khi render để tránh chớp màu (FOUC) -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("icdh:theme");
          if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Bỏ qua điều hướng, tới nội dung chính</a>
    <SiteHeader currentPath={path} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
