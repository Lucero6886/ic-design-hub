---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { href } from "~/utils/url";
---

<BaseLayout title="Không tìm thấy trang (404)" noindex={true} path="404.html">
  <div class="wrap" style="padding:60px 20px; text-align:center">
    <h1 style="font-size:64px;margin:0;color:var(--acc)">404</h1>
    <p style="font-size:18px">Trang bạn tìm không tồn tại hoặc đã được chuyển chỗ.</p>
    <p class="muted">
      Nội dung giáo trình cũ hiện nằm dưới đường dẫn <code>legacy/</code> —
      thử <a href={href("legacy/index.html")}>cổng giáo trình V1/V2/V3</a> hoặc dùng tìm kiếm.
    </p>
    <div class="btn-row" style="justify-content:center;margin-top:18px">
      <a class="btn primary" href={href("")}>Về trang chủ</a>
      <a class="btn" href={href("search/")}>Tìm kiếm</a>
    </div>
  </div>
</BaseLayout>
