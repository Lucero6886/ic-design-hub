---
import EntryLayout from "~/layouts/EntryLayout.astro";
import { render } from "astro:content";
import { href, readingTime } from "~/utils/url";
import { getPublished, label } from "~/utils/content";

export async function getStaticPaths() {
  const notes = await getPublished("research");
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<EntryLayout
  title={d.title}
  summary={d.summary}
  path={`research/${entry.id}/`}
  crumbs={[
    { label: "Trang chủ", url: href("") },
    { label: "Nghiên cứu", url: href("research/") },
    { label: d.title },
  ]}
  date={d.date}
  updated={d.updated}
  author={d.author}
  lang={d.lang}
  minutes={readingTime(entry.body)}
  track={d.track}
  tags={d.tags}
  badges={[
    { text: label(d.kind), tone: "acc" },
    { text: label(d.status), tone: "gray" },
    { text: label(d.evidenceLevel), tone: "warn" },
  ]}
  attribution={d.attribution}
  references={d.references}
  relatedArticles={d.relatedArticles}
  relatedProjects={d.relatedProjects}
  relatedResearch={d.relatedResearch}
>
  <div slot="before-body">
    {d.paper && (
      <p class="co info"><b>Paper:</b> {d.paper}</p>
    )}
  </div>
  <Content />
</EntryLayout>
