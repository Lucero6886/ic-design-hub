---
import BaseLayout from "~/layouts/BaseLayout.astro";
import EntryList from "~/components/EntryList.astro";
import { href } from "~/utils/url";
import { getPublished, label } from "~/utils/content";

const articles = await getPublished("articles");
const categories = [...new Set(articles.map((a) => a.data.category))];
---

<BaseLayout
  title="Bài viết"
  description="Bài viết kỹ thuật, tutorial, khái niệm và ghi chú mentoring về thiết kế vi mạch — RTL, SystemVerilog, FPGA, verification."
  path="articles/"
>
  <section class="hero">
    <div class="wrap">
      <div class="kicker">Knowledge</div>
      <h1>Bài viết</h1>
      <p class="sub">
        Tutorial, khái niệm, ghi chú kỹ thuật và bài mentoring — viết theo kỷ luật:
        phát biểu → phạm vi → giả định → giới hạn → dẫn chứng.
      </p>
    </div>
  </section>
  <section class="section" style="padding-bottom:28px">
    <div class="wrap">
      {categories.length > 1 && (
        <p class="sec-sub">
          Thể loại: {categories.map((c, i) => (
            <span>{i > 0 && " · "}{label(c)}</span>
          ))}
        </p>
      )}
      <EntryList
        items={articles.map((a) => ({
          url: href(`articles/${a.id}/`),
          title: a.data.title,
          summary: a.data.summary,
          date: a.data.date,
          updated: a.data.updated,
          track: a.data.track,
          tags: a.data.tags,
          badges: [
            { text: label(a.data.category), tone: "acc" },
            ...(a.data.difficulty ? [{ text: label(a.data.difficulty), tone: "gray" as const }] : []),
          ],
        }))}
        emptyText="Chưa có bài viết nào được công bố. Bài viết mới chỉ cần một file Markdown — xem docs/AUTHORING_GUIDE.md."
      />
    </div>
  </section>
</BaseLayout>
